# Copy this file to .env and adjust as needed:
#   cp .env.example .env
#
# Used both by the bare binary (internal/config loads .env automatically
# from the working directory) and by docker-compose.yml (via env_file:).
# Everything here is optional — defaults shown are what the app uses if
# a variable is unset.
#
# Everything *except* these process-level settings (sources, filters,
# rules, poll interval after first run, feed title, ...) is configured
# from the admin UI instead and lives in the database, not here.

# Admin UI port (settings, CRUD, stats). Keep this LAN-only — see
# README.md#deployment. Under Docker Compose, this also becomes the
# host-side published port (docker-compose.yml's ports: substitutes it
# directly), so changing it moves both sides together.
PERMEABLE_ADMIN_PORT=8080

# Feed-only port (GET /feed.ics). The one port safe to reverse-proxy or
# expose publicly. Same host+container behavior under Compose as above.
PERMEABLE_FEED_PORT=8081

# Compose-only: which host address the admin port is published on (see
# docker-compose.yml). Not read by the app itself — 127.0.0.1 keeps the
# admin UI unreachable from outside the host; set it to a LAN interface
# address if you want LAN-wide access instead. Never 0.0.0.0 on a host
# with a public IP.
PERMEABLE_ADMIN_BIND_HOST=127.0.0.1

# Seeds the poll interval (minutes) the *first* time the database is
# created. After that, change it from the admin UI instead — this
# variable has no effect on an existing database.
PERMEABLE_REFRESH_MINUTES=60

# Path to the SQLite database file. Bare-binary use only — under Docker
# this is fixed to /data/permeable.db by the Dockerfile's CMD, and
# setting this in .env won't change it (see docker-compose.yml).
# PERMEABLE_DB_PATH=data/permeable.db
